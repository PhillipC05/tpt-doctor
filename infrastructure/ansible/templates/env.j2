# ============================================================================
# TPT Doctor — Environment Configuration (Ansible Generated)
# ============================================================================

# Database
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}
DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}

# Redis
REDIS_PASSWORD={{ redis_password }}
REDIS_URL=redis://:{{ redis_password }}@redis:6379

# Storage (MinIO)
MINIO_ACCESS_KEY={{ minio_access_key }}
MINIO_SECRET_KEY={{ minio_secret_key }}
MINIO_ENDPOINT=http://minio:9000
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY={{ minio_access_key }}
STORAGE_SECRET_KEY={{ minio_secret_key }}
STORAGE_BUCKET=tpt-documents

# Auth0
AUTH0_DOMAIN={{ auth0_domain }}
AUTH0_AUDIENCE={{ auth0_audience }}
AUTH0_WEB_CLIENT_ID={{ auth0_web_client_id }}
AUTH0_PORTAL_CLIENT_ID={{ auth0_portal_client_id }}

# Encryption
ENCRYPTION_PROVIDER=local
ENCRYPTION_MASTER_KEY={{ encryption_master_key }}
BACKUP_ENCRYPTION_KEY={{ encryption_master_key }}

# Jitsi
JITSI_PASSWORD={{ jitsi_password }}

# Monitoring
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}

# Node
NODE_ENV=production
LOG_LEVEL=info
// ============================================================================
// TPT Doctor — Prisma Schema (PostgreSQL)
// HIPAA/GDPR/AU/NZ Compliant with Row-Level Security
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp, pgcrypto]
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  PRACTICE_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PATIENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum EncounterType {
  OFFICE_VISIT
  TELEMEDICINE
  HOME_VISIT
  EMERGENCY
  FOLLOW_UP
  ROUTINE_CHECKUP
  CONSULTATION
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  DOMESTIC_PARTNER
}

enum InsuranceType {
  PRIVATE
  MEDICARE
  MEDICAID
  VA
  SELF_PAY
  WORKERS_COMP
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  PAID
  DENIED
  APPEALED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  ACH
  CASH
  CHECK
}

enum PaymentProvider {
  STRIPE
  AIRWALLEX
}

enum PrescriptionStatus {
  DRAFT
  SUBMITTED
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  EXPIRED
}

enum LabStatus {
  ORDERED
  SPECIMEN_COLLECTED
  IN_TRANSIT
  IN_PROGRESS
  COMPLETED
  REVIEWED
  CANCELLED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  PRINT
  VIEW_PHI
  CONSENT_GRANTED
  CONSENT_REVOKED
  DATA_BREACH
}

enum ConsentType {
  TREATMENT
  PAYMENT
  HEALTHCARE_OPERATIONS
  RESEARCH
  MARKETING
  DISCLOSURE
  TELEMEDICINE
  RECORDING
}

enum ComplianceFramework {
  HIPAA
  GDPR
  AU_PRIVACY
  NZ_HISO
}

enum DataRegion {
  US
  EU
  AU
  NZ
}

enum Severity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum NotificationType {
  APPOINTMENT_REMINDER
  LAB_RESULT
  MESSAGE
  PRESCRIPTION_REFILL
  BILLING
  SYSTEM
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  CANCELLED
  EXPIRED
}

enum ReminderChannel {
  EMAIL
  SMS
  BOTH
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum CheckInStatus {
  PENDING
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

enum PTOStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum CredentialType {
  MEDICAL_LICENSE
  BOARD_CERTIFICATION
  DEA_REGISTRATION
  NPI_NUMBER
  MALPRACTICE_INSURANCE
  BLS_CERTIFICATION
  ACLS_CERTIFICATION
  CONTINUING_EDUCATION
  HOSPITAL_PRIVILEGES
  MEDICAID_PROVIDER
  MEDICARE_PROVIDER
}

enum CredentialStatus {
  ACTIVE
  EXPIRED
  PENDING_RENEWAL
  REVOKED
  SUSPENDED
}

enum DecisionSupportCategory {
  DRUG_INTERACTION
  ALLERGY_CHECK
  DOSAGE_CHECK
  DUPLICATE_THERAPY
  PREVENTIVE_CARE
  GUIDELINE_COMPLIANCE
  AGE_BASED
  CONDITION_BASED
}

enum DecisionSupportSeverity {
  INFO
  WARNING
  CRITICAL
}

// ============================================================================
// MODELS
// ============================================================================

// --- Tenant / Organization ---
model Tenant {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @db.VarChar(200)
  slug                 String                @unique @db.VarChar(50)
  dataRegion           DataRegion
  complianceFrameworks ComplianceFramework[]
  isActive             Boolean               @default(true)
  settings             Json                  @default("{}") // TenantSettings
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  staff         StaffMember[]
  patients      Patient[]
  appointments  Appointment[]
  encounters    Encounter[]
  invoices      Invoice[]
  claims        Claim[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  documents     Document[]
  auditLogs     AuditLogEntry[]
  messages      Message[]
  notifications Notification[]
  payments      Payment[]

  // Phase 14 relations
  savedReports                SavedReport[]
  reportExecutionLogs         ReportExecutionLog[]
  revenueSnapshots            RevenueAnalyticsSnapshot[]
  appointmentUtilSnapshots    AppointmentUtilizationSnapshot[]
  clinicianProductivitySnaps  ClinicianProductivitySnapshot[]
  clinicRooms                 ClinicRoom[]
  roomOccupancyLogs           RoomOccupancyLog[]
  tasks                       Task[]
  taskComments                TaskComment[]
  documentFolders             DocumentFolder[]
  documentTags                DocumentTag[]
  letterTemplates             LetterTemplate[]
  generatedLetters            GeneratedLetter[]
  inventoryCategories         InventoryCategory[]
  inventoryItems              InventoryItem[]
  inventoryTransactions       InventoryTransaction[]
  purchaseOrders              PurchaseOrder[]
  vaccineInventory            VaccineInventory[]
  vaccineAdministrations      VaccineAdministration[]
  medicationSamples           MedicationSample[]
  sampleDistributions         SampleDistribution[]
  retailProducts              RetailProduct[]
  posSales                    PosSale[]
  WaitlistEntry               WaitlistEntry[]
  BlockTime                   BlockTime[]
  AppointmentReminder         AppointmentReminder[]
  MessageTemplate             MessageTemplate[]
  InsuranceVerification       InsuranceVerification[]
  ClaimSubmission             ClaimSubmission[]
  EraRecord                   EraRecord[]
  BillingStatement            BillingStatement[]
  WriteOff                    WriteOff[]
  Refund                      Refund[]
  CopayCollection             CopayCollection[]
  HsaFsaAccount               HsaFsaAccount[]
  ControlledSubstanceLog      ControlledSubstanceLog[]
  EPrescribingTransaction     EPrescribingTransaction[]
  LabPanel                    LabPanel[]
  ExternalLabConfig           ExternalLabConfig[]
  FhirImportLog               FhirImportLog[]
  AgingReport                 AgingReport[]
  CheckInRecord               CheckInRecord[]
  TimeOffRequest              TimeOffRequest[]
  Credential                  Credential[]
  EhrTemplate                 EhrTemplate[]
  DecisionSupportRule         DecisionSupportRule[]
  PatientMergeLog             PatientMergeLog[]
  TelemedicineSession         TelemedicineSession[]
  Referral                    Referral[]
  CarePlan                    CarePlan[]
  MedicalCertificate          MedicalCertificate[]
  PatientIntake               PatientIntake[]
  CountryProfileConfig        CountryProfileConfig[]
  MbsClaimSubmission          MbsClaimSubmission[]
  PbsPrescription             PbsPrescription[]
  MyHealthRecordDocument      MyHealthRecordDocument[]
  AirRecordSubmission         AirRecordSubmission[]
  PipReport                   PipReport[]
  NzClaimSubmission           NzClaimSubmission[]
  PhoReport                   PhoReport[]
  NzImmunisationSubmission    NzImmunisationSubmission[]
  NhiValidationLog            NhiValidationLog[]
  UkGp2GpTransfer             UkGp2GpTransfer[]
  UkQofReport                 UkQofReport[]
  UkGpConnectInteraction      UkGpConnectInteraction[]
  UkSpineInteraction          UkSpineInteraction[]
  UkEpsPrescription           UkEpsPrescription[]
  CaProvincialClaimSubmission CaProvincialClaimSubmission[]
  CaImmunisationSubmission    CaImmunisationSubmission[]
  CaInfowayInteraction        CaInfowayInteraction[]
  ApiKey                      ApiKey[]

  @@map("tenants")
}

// --- Users (Auth0-linked) ---
model User {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique @db.VarChar(255)
  firstName   String    @db.VarChar(100)
  lastName    String    @db.VarChar(100)
  phone       String?   @db.VarChar(20)
  avatarUrl   String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  auth0Id     String    @unique @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  staffProfile     StaffMember?
  patientProfile   Patient?
  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  notifications    Notification[]
  auditLogs        AuditLogEntry[]
  consentGiven     PatientConsent[] @relation("ConsentGivenBy")
  EhrTemplate      EhrTemplate[]

  @@map("users")
}

// --- Staff Members ---
model StaffMember {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  userId         String   @unique @db.Uuid
  role           UserRole
  permissions    String[] // Permission enum values
  title          String   @db.VarChar(200)
  licenseNumber  String?  @db.VarChar(100)
  npiNumber      String?  @db.VarChar(50) // US NPI
  specialization String?  @db.VarChar(200)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant                        Tenant                          @relation(fields: [tenantId], references: [id])
  user                          User                            @relation(fields: [userId], references: [id])
  primaryCarePatients           Patient[]                       @relation("PrimaryCareProvider")
  appointments                  Appointment[]
  encounters                    Encounter[]
  prescriptions                 Prescription[]
  labOrders                     LabOrder[]
  schedules                     StaffSchedule[]
  WaitlistEntry                 WaitlistEntry[]
  BlockTime                     BlockTime[]
  ControlledSubstanceLog        ControlledSubstanceLog[]
  TimeOffRequest                TimeOffRequest[]
  Credential                    Credential[]
  TelemedicineSession           TelemedicineSession[]
  Referral                      Referral[]
  CarePlan                      CarePlan[]
  MedicalCertificate            MedicalCertificate[]
  PatientIntake                 PatientIntake[]
  PbsPrescription               PbsPrescription[]
  ClinicianProductivitySnapshot ClinicianProductivitySnapshot[]
  Task                          Task[]
  SampleDistribution            SampleDistribution[]

  @@unique([tenantId, licenseNumber])
  @@unique([tenantId, npiNumber])
  @@map("staff_members")
}

// --- Staff Schedules ---
model StaffSchedule {
  id           String    @id @default(uuid()) @db.Uuid
  staffId      String    @db.Uuid
  dayOfWeek    Int // 0=Sunday, 6=Saturday
  startTime    String    @db.VarChar(5) // "09:00"
  endTime      String    @db.VarChar(5) // "17:00"
  isAvailable  Boolean   @default(true)
  isRecurring  Boolean   @default(true)
  specificDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  staff StaffMember @relation(fields: [staffId], references: [id])

  @@unique([staffId, dayOfWeek, specificDate])
  @@map("staff_schedules")
}

// --- Patients ---
model Patient {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  userId                String?        @unique @db.Uuid
  medicalRecordNumber   String         @unique @db.VarChar(50)
  firstName             String         @db.VarChar(100)
  lastName              String         @db.VarChar(100)
  dateOfBirth           DateTime       @db.Date
  gender                Gender
  bloodType             BloodType?
  maritalStatus         MaritalStatus?
  ssn                   String? // Encrypted PHI
  email                 String         @db.VarChar(255)
  phone                 String         @db.VarChar(20)
  address               Json           @default("{}") // Address
  emergencyContact      Json? // EmergencyContact
  primaryCareProviderId String?        @db.Uuid
  preferredPharmacyId   String?        @db.Uuid
  isActive              Boolean        @default(true)
  tags                  String[]       @default([])
  notes                 String?        @db.Text
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tenant                      Tenant                        @relation(fields: [tenantId], references: [id])
  user                        User?                         @relation(fields: [userId], references: [id])
  primaryCareProvider         StaffMember?                  @relation("PrimaryCareProvider", fields: [primaryCareProviderId], references: [id])
  insurance                   PatientInsurance[]
  consents                    PatientConsent[]
  appointments                Appointment[]
  encounters                  Encounter[]
  medicalConditions           MedicalCondition[]
  allergies                   Allergy[]
  immunizations               Immunization[]
  medications                 PatientMedication[]
  documents                   Document[]
  invoices                    Invoice[]
  claims                      Claim[]
  prescriptions               Prescription[]
  labOrders                   LabOrder[]
  WaitlistEntry               WaitlistEntry[]
  InsuranceVerification       InsuranceVerification[]
  BillingStatement            BillingStatement[]
  CopayCollection             CopayCollection[]
  HsaFsaAccount               HsaFsaAccount[]
  ControlledSubstanceLog      ControlledSubstanceLog[]
  CheckInRecord               CheckInRecord[]
  TelemedicineSession         TelemedicineSession[]
  Referral                    Referral[]
  CarePlan                    CarePlan[]
  MedicalCertificate          MedicalCertificate[]
  PatientIntake               PatientIntake[]
  MbsClaimSubmission          MbsClaimSubmission[]
  PbsPrescription             PbsPrescription[]
  MyHealthRecordDocument      MyHealthRecordDocument[]
  AirRecordSubmission         AirRecordSubmission[]
  NzClaimSubmission           NzClaimSubmission[]
  NzImmunisationSubmission    NzImmunisationSubmission[]
  UkGp2GpTransfer             UkGp2GpTransfer[]
  UkGpConnectInteraction      UkGpConnectInteraction[]
  UkSpineInteraction          UkSpineInteraction[]
  CaProvincialClaimSubmission CaProvincialClaimSubmission[]
  CaImmunisationSubmission    CaImmunisationSubmission[]
  CaInfowayInteraction        CaInfowayInteraction[]
  GeneratedLetter             GeneratedLetter[]
  VaccineAdministration       VaccineAdministration[]
  SampleDistribution          SampleDistribution[]
  PosSale                     PosSale[]

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, medicalRecordNumber])
  @@index([tenantId, email])
  @@map("patients")
}

// --- Patient Insurance ---
model PatientInsurance {
  id            String        @id @default(uuid()) @db.Uuid
  patientId     String        @db.Uuid
  provider      String        @db.VarChar(200)
  policyNumber  String        @db.VarChar(100)
  groupNumber   String?       @db.VarChar(100)
  insuranceType InsuranceType
  isPrimary     Boolean       @default(false)
  coverageStart DateTime      @db.Date
  coverageEnd   DateTime?     @db.Date
  copay         Decimal       @default(0) @db.Decimal(10, 2)
  deductible    Decimal       @default(0) @db.Decimal(10, 2)
  deductibleMet Decimal       @default(0) @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient               Patient                 @relation(fields: [patientId], references: [id])
  claims                Claim[]
  InsuranceVerification InsuranceVerification[]

  @@map("patient_insurance")
}

// --- Patient Consents ---
model PatientConsent {
  id          String      @id @default(uuid()) @db.Uuid
  patientId   String      @db.Uuid
  consentType ConsentType
  isGranted   Boolean     @default(false)
  grantedAt   DateTime?
  grantedBy   String?     @db.Uuid // User ID who recorded consent
  revokedAt   DateTime?
  expiresAt   DateTime?
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  patient       Patient @relation(fields: [patientId], references: [id])
  grantedByUser User?   @relation("ConsentGivenBy", fields: [grantedBy], references: [id])

  @@unique([patientId, consentType])
  @@map("patient_consents")
}

// --- Appointments ---
model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  patientId        String            @db.Uuid
  staffId          String            @db.Uuid
  title            String            @db.VarChar(200)
  description      String?           @db.Text
  startTime        DateTime
  endTime          DateTime
  status           AppointmentStatus @default(SCHEDULED)
  type             EncounterType
  isRecurring      Boolean           @default(false)
  recurringPattern Json? // RecurringPattern
  location         String?           @db.VarChar(200)
  notes            String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  patient             Patient               @relation(fields: [patientId], references: [id])
  staff               StaffMember           @relation(fields: [staffId], references: [id])
  encounter           Encounter?
  AppointmentReminder AppointmentReminder[]
  CopayCollection     CopayCollection[]
  CheckInRecord       CheckInRecord?
  TelemedicineSession TelemedicineSession?

  @@index([tenantId, startTime])
  @@index([tenantId, patientId])
  @@index([tenantId, staffId])
  @@map("appointments")
}

// --- Encounters (EHR / SOAP Notes) ---
model Encounter {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  patientId      String        @db.Uuid
  staffId        String        @db.Uuid
  appointmentId  String?       @unique @db.Uuid
  encounterType  EncounterType
  date           DateTime      @default(now())
  chiefComplaint String        @db.VarChar(500)
  subjective     String?       @db.Text
  objective      String?       @db.Text
  assessment     String?       @db.Text
  plan           String?       @db.Text
  vitals         Json? // Vitals
  isSigned       Boolean       @default(false)
  signedAt       DateTime?
  signedBy       String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  patient        Patient         @relation(fields: [patientId], references: [id])
  staff          StaffMember     @relation(fields: [staffId], references: [id])
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  diagnosisCodes DiagnosisCode[]
  documents      Document[]

  @@index([tenantId, patientId])
  @@index([tenantId, date])
  @@map("encounters")
}

// --- Diagnosis Codes (ICD-10) ---
model DiagnosisCode {
  id          String   @id @default(uuid()) @db.Uuid
  encounterId String   @db.Uuid
  code        String   @db.VarChar(20) // ICD-10
  description String   @db.VarChar(500)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@map("diagnosis_codes")
}

// --- Medical Conditions ---
model MedicalCondition {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @db.Uuid
  code         String    @db.VarChar(20)
  description  String    @db.VarChar(500)
  onsetDate    DateTime  @db.Date
  resolvedDate DateTime? @db.Date
  isChronic    Boolean   @default(false)
  severity     String?   @db.VarChar(20) // MILD, MODERATE, SEVERE
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("medical_conditions")
}

// --- Allergies ---
model Allergy {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  allergen  String   @db.VarChar(200)
  reaction  String   @db.VarChar(500)
  severity  Severity @default(WARNING)
  onsetDate DateTime @db.Date
  isActive  Boolean  @default(true)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("allergies")
}

// --- Immunizations ---
model Immunization {
  id                 String   @id @default(uuid()) @db.Uuid
  patientId          String   @db.Uuid
  vaccineName        String   @db.VarChar(200)
  cvxCode            String   @db.VarChar(10)
  administrationDate DateTime @db.Date
  administeredBy     String   @db.VarChar(200)
  lotNumber          String   @db.VarChar(50)
  manufacturer       String   @db.VarChar(200)
  doseNumber         Int      @default(1)
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient               Patient                 @relation(fields: [patientId], references: [id])
  VaccineAdministration VaccineAdministration[]

  @@index([patientId])
  @@map("immunizations")
}

// --- Patient Medications ---
model PatientMedication {
  id             String    @id @default(uuid()) @db.Uuid
  patientId      String    @db.Uuid
  medicationName String    @db.VarChar(200)
  strength       String    @db.VarChar(100)
  form           String    @db.VarChar(100)
  route          String    @db.VarChar(100)
  frequency      String    @db.VarChar(100)
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  isActive       Boolean   @default(true)
  prescribedBy   String    @db.Uuid
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("patient_medications")
}

// --- Documents ---
model Document {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  encounterId String?  @db.Uuid
  patientId   String   @db.Uuid
  fileName    String   @db.VarChar(255)
  fileSize    Int
  mimeType    String   @db.VarChar(100)
  storageKey  String   @unique @db.VarChar(500) // Encrypted S3/MinIO key
  category    String?  @db.VarChar(100) // LAB_RESULT, IMAGING, CONSENT, etc.
  isEncrypted Boolean  @default(true)
  uploadedBy  String   @db.Uuid
  createdAt   DateTime @default(now())

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  encounter       Encounter?        @relation(fields: [encounterId], references: [id])
  patient         Patient           @relation(fields: [patientId], references: [id])
  DocumentVersion DocumentVersion[]

  @@index([patientId])
  @@index([tenantId])
  @@map("documents")
}

// --- Billing: Invoices ---
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  patientId     String        @db.Uuid
  invoiceNumber String        @unique @db.VarChar(50)
  items         Json          @default("[]") // InvoiceItem[]
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue    Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  dueDate       DateTime
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  patient  Patient    @relation(fields: [patientId], references: [id])
  claims   Claim[]
  payments Payment[]
  WriteOff WriteOff[]
  Refund   Refund[]

  @@index([tenantId, patientId])
  @@index([tenantId, invoiceNumber])
  @@map("invoices")
}

// --- Billing: Claims ---
model Claim {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  patientId     String      @db.Uuid
  invoiceId     String      @db.Uuid
  claimNumber   String      @unique @db.VarChar(50)
  insuranceId   String      @db.Uuid
  serviceDate   DateTime    @db.Date
  submittedDate DateTime?
  status        ClaimStatus @default(DRAFT)
  amount        Decimal     @db.Decimal(12, 2)
  paidAmount    Decimal     @default(0) @db.Decimal(12, 2)
  denialReason  String?     @db.Text
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  patient         Patient           @relation(fields: [patientId], references: [id])
  invoice         Invoice           @relation(fields: [invoiceId], references: [id])
  insurance       PatientInsurance  @relation(fields: [insuranceId], references: [id])
  ClaimSubmission ClaimSubmission[]
  EraRecord       EraRecord[]

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@map("claims")
}

// --- Billing: Payments ---
model Payment {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  invoiceId       String          @db.Uuid
  amount          Decimal         @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  paymentProvider PaymentProvider
  transactionId   String?         @db.VarChar(200) // Stripe/Airwallex transaction ID
  status          PaymentStatus   @default(PENDING)
  paidAt          DateTime        @default(now())

}

// --- HSA / FSA Accounts ---
model HsaFsaAccount {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  patientId         String   @db.Uuid
  accountType       String   @db.VarChar(10) // HSA, FSA
  accountNumber     String   @db.VarChar(100)
  providerName      String   @db.VarChar(200)
  balance           Decimal  @default(0) @db.Decimal(12, 2)
  contributionLimit Decimal? @db.Decimal(12, 2)
  isVerified        Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId])
  @@map("hsa_fsa_accounts")
}

// --- Pharmacy Directory ---
model Pharmacy {
  id                      String                    @id @default(uuid()) @db.Uuid
  name                    String                    @db.VarChar(200)
  ncpdpId                 String?                   @unique @db.VarChar(50) // National Council for Prescription Drug Programs ID
  npiNumber               String?                   @db.VarChar(50)
  address                 Json                      @default("{}") // Address
  phone                   String?                   @db.VarChar(20)
  fax                     String?                   @db.VarChar(20)
  email                   String?                   @db.VarChar(255)
  isActive                Boolean                   @default(true)
  supportsEprescribing    Boolean                   @default(true)
  supportedNetworks       String[] // e.g. ["Surescripts", "RxHub"]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  EPrescribingTransaction EPrescribingTransaction[]

  @@map("pharmacies")
}

// --- Drug Database (for interaction checking) ---
model Drug {
  id           String   @id @default(uuid()) @db.Uuid
  ndc          String   @unique @db.VarChar(50) // National Drug Code
  name         String   @db.VarChar(300)
  genericName  String?  @db.VarChar(300)
  brandName    String?  @db.VarChar(300)
  drugClass    String?  @db.VarChar(100)
  route        String?  @db.VarChar(100)
  strength     String?  @db.VarChar(100)
  form         String?  @db.VarChar(100)
  manufacturer String?  @db.VarChar(200)
  isControlled Boolean  @default(false)
  schedule     String?  @db.VarChar(10) // CII, CIII, CIV, CV
  deaClass     String?  @db.VarChar(50)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interactions   DrugInteraction[] @relation("DrugAInteractions")
  interactedWith DrugInteraction[] @relation("DrugBInteractions")

  @@index([name])
  @@index([ndc])
  @@map("drugs")
}

// --- Drug Interactions ---
model DrugInteraction {
  id                String                  @id @default(uuid()) @db.Uuid
  drugId            String                  @db.Uuid
  interactingDrugId String                  @db.Uuid
  severity          DecisionSupportSeverity @default(WARNING)
  description       String                  @db.Text
  mechanism         String?                 @db.VarChar(500)
  management        String?                 @db.Text
  evidence          String?                 @db.VarChar(500)
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  drug            Drug @relation("DrugAInteractions", fields: [drugId], references: [id])
  interactingDrug Drug @relation("DrugBInteractions", fields: [interactingDrugId], references: [id])

  @@unique([drugId, interactingDrugId])
  @@map("drug_interactions")
}

// --- Controlled Substance Tracking ---

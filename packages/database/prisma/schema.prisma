// === Letter Generation Engine ===

enum LetterStatus {
  DRAFT
  GENERATED
  SENT
  PRINTED
  VOID
}

model LetterTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  category        String   @db.VarChar(100) // REFERRAL, CERTIFICATE, CORRESPONDENCE, NOTICE
  subjectTemplate String   @db.VarChar(500)
  bodyTemplate    String   @db.Text // Handlebars/Mail-merge template
  variables       String[] // Supported variables
  format          String   @default("PDF") @db.VarChar(20) // PDF, DOCX, HTML
  isActive        Boolean  @default(true)
  createdBy       String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  GeneratedLetter GeneratedLetter[]

  @@index([tenantId, category])
  @@map("letter_templates")
}

model GeneratedLetter {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  templateId String?      @db.Uuid
  patientId  String       @db.Uuid
  staffId    String?      @db.Uuid
  title      String       @db.VarChar(500)
  content    String       @db.Text // Rendered letter content
  variables  Json         @default("{}") // Variables used with values
  status     LetterStatus @default(DRAFT)
  format     String       @default("PDF") @db.VarChar(20)
  storageKey String?      @db.VarChar(500) // S3/MinIO key for generated file
  sentVia    String?      @db.VarChar(50) // EMAIL, PRINT, PORTAL, MAIL
  sentAt     DateTime?
  sentTo     String?      @db.VarChar(500) // Email or address
  printedAt  DateTime?
  createdBy  String       @db.Uuid
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  template LetterTemplate? @relation(fields: [templateId], references: [id])
  patient  Patient         @relation(fields: [patientId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@index([tenantId, createdAt])
  @@map("generated_letters")
}

// ============================================================================
// 14.3 — Inventory Management
// ============================================================================

// === Clinic Supply Inventory ===

enum InventoryUnitType {
  EACH
  BOX
  CASE
  PACK
  BOTTLE
  TUBE
  BAG
  SET
}

model InventoryCategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  parentId    String?  @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  InventoryItem InventoryItem[]

  @@unique([tenantId, name])
  @@map("inventory_categories")
}

model InventoryItem {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  categoryId      String?           @db.Uuid
  name            String            @db.VarChar(300)
  sku             String            @db.VarChar(100)
  description     String?           @db.Text
  unitType        InventoryUnitType @default(EACH)
  unitCost        Decimal           @default(0) @db.Decimal(10, 2)
  unitPrice       Decimal           @default(0) @db.Decimal(10, 2)
  currentStock    Int               @default(0)
  minimumStock    Int               @default(0) // Reorder point
  maximumStock    Int               @default(0)
  reorderQuantity Int               @default(0)
  location        String?           @db.VarChar(200) // Storage location
  supplier        String?           @db.VarChar(200)
  supplierSku     String?           @db.VarChar(100)
  isActive        Boolean           @default(true)
  isControlled    Boolean           @default(false)
  requiresRx      Boolean           @default(false)
  expiryDate      DateTime?         @db.Date
  batchNumber     String?           @db.VarChar(100)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  category             InventoryCategory?     @relation(fields: [categoryId], references: [id])
  InventoryTransaction InventoryTransaction[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@index([tenantId, currentStock])
  @@map("inventory_items")
}

// === Inventory Transactions ===

model InventoryTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  itemId          String   @db.Uuid
  transactionType String   @db.VarChar(50) // RECEIVED, USED, ADJUSTED, RETURNED, TRANSFERRED, WASTED
  quantity        Int // Negative for usage, positive for receipt
  previousStock   Int
  newStock        Int
  unitCost        Decimal  @default(0) @db.Decimal(10, 2)
  totalCost       Decimal  @default(0) @db.Decimal(12, 2)
  reference       String?  @db.VarChar(200) // PO number, usage reference
  performedBy     String   @db.Uuid
  patientId       String?  @db.Uuid
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  item   InventoryItem @relation(fields: [itemId], references: [id])

  @@index([tenantId, itemId])
  @@index([tenantId, transactionType])
  @@index([tenantId, createdAt])
  @@map("inventory_transactions")
}

// === Purchase Orders ===

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  poNumber     String              @db.VarChar(50)
  supplier     String              @db.VarChar(200)
  status       PurchaseOrderStatus @default(DRAFT)
  items        Json                @default("[]") // [{itemId, sku, name, quantity, unitCost, totalCost, receivedQuantity}]
  subtotal     Decimal             @default(0) @db.Decimal(12, 2)
  tax          Decimal             @default(0) @db.Decimal(12, 2)
  shippingCost Decimal             @default(0) @db.Decimal(12, 2)
  totalCost    Decimal             @default(0) @db.Decimal(12, 2)
  orderedAt    DateTime?
  expectedDate DateTime?           @db.Date
  receivedAt   DateTime?
  notes        String?             @db.Text
  createdBy    String              @db.Uuid
  approvedBy   String?             @db.Uuid
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, poNumber])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

// === Vaccine Inventory ===

enum VaccineStorageType {
  REFRIGERATED // 2-8°C
  FROZEN // -15°C or colder
  ULTRA_FROZEN // -60°C to -80°C
  AMBIENT
}

enum VaccineStatus {
  IN_STOCK
  IN_USE
  EXPIRED
  WASTED
  TRANSFERRED
}

model VaccineInventory {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  vaccineName        String             @db.VarChar(200)
  cvxCode            String             @db.VarChar(10)
  manufacturer       String             @db.VarChar(200)
  lotNumber          String             @db.VarChar(100)
  ndc                String?            @db.VarChar(50)
  storageType        VaccineStorageType @default(REFRIGERATED)
  status             VaccineStatus      @default(IN_STOCK)
  quantityReceived   Int                @default(0)
  quantityUsed       Int                @default(0)
  quantityWasted     Int                @default(0)
  quantityAvailable  Int                @default(0)
  unitCost           Decimal            @default(0) @db.Decimal(10, 2)
  receivedDate       DateTime           @db.Date
  expiryDate         DateTime           @db.Date
  manufacturerLotRef String?            @db.VarChar(200)

  // Cold chain monitoring
  temperatureLogs   Json      @default("[]") // [{timestamp, tempCelsius, deviceId, alert}]
  lastTempCheck     DateTime?
  lastTempReading   Decimal?  @db.Decimal(5, 2)
  coldChainBreach   Boolean   @default(false)
  coldChainBreachAt DateTime?

  storageLocation String?  @db.VarChar(200)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant                Tenant                  @relation(fields: [tenantId], references: [id])
  VaccineAdministration VaccineAdministration[]

  @@unique([tenantId, lotNumber, cvxCode])
  @@index([tenantId, status])
  @@index([tenantId, expiryDate])
  @@map("vaccine_inventory")
}

// === Vaccine Administration Record (tied to existing Immunization model) ===

model VaccineAdministration {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  patientId             String   @db.Uuid
  immunizationId        String   @db.Uuid
  vaccineLotId          String   @db.Uuid
  doseNumber            Int
  siteOfAdministration  String?  @db.VarChar(100)
  routeOfAdministration String?  @db.VarChar(100)
  administeredBy        String   @db.Uuid
  administeredAt        DateTime @default(now())
  consentObtained       Boolean  @default(false)
  adverseReaction       Boolean  @default(false)
  adverseReactionNotes  String?  @db.Text
  createdAt             DateTime @default(now())

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id])
  immunization Immunization     @relation(fields: [immunizationId], references: [id])
  vaccineLot   VaccineInventory @relation(fields: [vaccineLotId], references: [id])

  @@index([tenantId, vaccineLotId])
  @@index([tenantId, administeredAt])
  @@map("vaccine_administrations")
}

// === Medication Sample Tracking ===

enum SampleStatus {
  IN_STOCK
  DISTRIBUTED
  EXPIRED
  RECALLED
  DISCONTINUED
}

model MedicationSample {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @db.Uuid
  medicationName    String       @db.VarChar(300)
  strength          String       @db.VarChar(100)
  form              String       @db.VarChar(100)
  manufacturer      String       @db.VarChar(200)
  ndc               String?      @db.VarChar(50)
  lotNumber         String       @db.VarChar(100)
  quantityReceived  Int          @default(0)
  quantityRemaining Int          @default(0)
  status            SampleStatus @default(IN_STOCK)
  expiryDate        DateTime     @db.Date
  receivedDate      DateTime     @default(now())
  storageLocation   String?      @db.VarChar(200)
  notes             String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  SampleDistribution SampleDistribution[]

  @@unique([tenantId, lotNumber, medicationName])
  @@index([tenantId, status])
  @@index([tenantId, expiryDate])
  @@map("medication_samples")
}

// === Sample Distribution Log ===

model SampleDistribution {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  sampleId        String   @db.Uuid
  patientId       String   @db.Uuid
  staffId         String   @db.Uuid
  quantity        Int
  purpose         String?  @db.VarChar(500) // Reason for sample
  prescriptionId  String?  @db.Uuid // Optional linked prescription
  consentObtained Boolean  @default(false)
  distributedAt   DateTime @default(now())
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  sample  MedicationSample @relation(fields: [sampleId], references: [id])
  patient Patient          @relation(fields: [patientId], references: [id])
  staff   StaffMember      @relation(fields: [staffId], references: [id])

  @@index([tenantId, sampleId])
  @@index([tenantId, patientId])
  @@index([tenantId, distributedAt])
  @@map("sample_distributions")
}

// === Retail Product Sales (Point-of-Sale) ===

enum PosPaymentMethod {
  CASH
  CARD
  MOBILE_PAYMENT
  INVOICE
  CLINIC_ACCOUNT
  OTHER
}

model RetailProduct {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  name         String   @db.VarChar(300)
  sku          String   @db.VarChar(100)
  description  String?  @db.Text
  category     String?  @db.VarChar(100)
  unitPrice    Decimal  @db.Decimal(10, 2)
  costPrice    Decimal  @default(0) @db.Decimal(10, 2)
  taxRate      Decimal  @default(0) @db.Decimal(5, 3)
  currentStock Int      @default(0)
  minimumStock Int      @default(0)
  isActive     Boolean  @default(true)
  isTaxable    Boolean  @default(true)
  barcode      String?  @db.VarChar(100)
  imageUrl     String?  @db.VarChar(500)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sku])
  @@index([tenantId, category])
  @@map("retail_products")
}

model PosSale {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  saleNumber     String           @unique @db.VarChar(50)
  items          Json             @default("[]") // [{productId, sku, name, quantity, unitPrice, totalPrice, tax}]
  subtotal       Decimal          @db.Decimal(12, 2)
  taxTotal       Decimal          @default(0) @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal          @db.Decimal(12, 2)
  paymentMethod  PosPaymentMethod
  amountTendered Decimal          @db.Decimal(12, 2)
  changeAmount   Decimal          @default(0) @db.Decimal(12, 2)
  patientId      String?          @db.Uuid // Optional patient link
  soldBy         String           @db.Uuid
  notes          String?          @db.Text
  soldAt         DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  patient Patient? @relation(fields: [patientId], references: [id])

  @@index([tenantId, soldAt])
  @@index([tenantId, paymentMethod])
  @@map("pos_sales")
}

// ============================================================================
// API Key Authentication (for external integrations: webhooks, FHIR clients)
// ============================================================================

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String    @db.VarChar(200)
  keyHash     String    @unique @db.VarChar(64) // SHA-256 hex of the raw key
  keyPrefix   String    @db.VarChar(8)          // First 8 chars shown in UI (tpt_xxxx)
  scopes      String[]  @default([])             // e.g. ["fhir:read", "webhooks:write"]
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdBy   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([keyHash])
  @@map("api_keys")
}

// ============================================================================
// EXTENSIONS: Row-Level Security (RLS) will be applied via migrations
// ============================================================================
// RLS Policy (applied in migration):
// - Every row has tenantId
// - Users can only see rows matching their tenant
// - SUPER_ADMIN can see all tenants

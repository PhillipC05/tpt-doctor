// === Task Management ===

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  title          String       @db.VarChar(300)
  description    String?      @db.Text
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  category       String?      @db.VarChar(100) // ADMIN, CLINICAL, BILLING, LAB, STAFF
  assignedToId   String?      @db.Uuid
  assignedById   String       @db.Uuid
  patientId      String?      @db.Uuid
  dueDate        DateTime?
  completedAt    DateTime?
  completedById  String?      @db.Uuid
  parentTaskId   String?      @db.Uuid
  estimatedHours Decimal?     @db.Decimal(6, 2)
  actualHours    Decimal?     @db.Decimal(6, 2)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  assignedTo  StaffMember?  @relation(fields: [assignedToId], references: [id])
  TaskComment TaskComment[]

  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, priority])
  @@index([tenantId, dueDate])
  @@map("tasks")
}

// === Task Comments ===

model TaskComment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  taskId      String   @db.Uuid
  userId      String   @db.Uuid
  comment     String   @db.Text
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  task   Task   @relation(fields: [taskId], references: [id])

  @@index([tenantId, taskId])
  @@map("task_comments")
}

// === Document Management System (Enhancement) ===

model DocumentFolder {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  name           String   @db.VarChar(200)
  parentFolderId String?  @db.Uuid
  description    String?  @db.Text
  isSystem       Boolean  @default(false) // System-managed folder
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  parentFolder DocumentFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id])
  childFolders DocumentFolder[] @relation("FolderHierarchy")

  @@unique([tenantId, name, parentFolderId])
  @@index([tenantId, parentFolderId])
  @@map("document_folders")
}

model DocumentTag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String   @db.VarChar(100)

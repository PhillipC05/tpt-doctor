// --- Check-in / Check-out ---
model CheckInRecord {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  appointmentId   String        @unique @db.Uuid
  patientId       String        @db.Uuid
  checkedInAt     DateTime      @default(now())
  checkedInBy     String        @db.Uuid
  checkedOutAt    DateTime?
  checkedOutBy    String?       @db.Uuid
  status          CheckInStatus @default(PENDING)
  waitTimeMinutes Int? // actual wait time
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@map("check_in_records")
}

// --- PTO / Leave Tracking ---
model TimeOffRequest {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  staffId    String    @db.Uuid
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  reason     String    @db.VarChar(500)
  type       String    @db.VarChar(50) // VACATION, SICK, PERSONAL, OTHER
  status     PTOStatus @default(PENDING)
  approvedBy String?   @db.Uuid
  approvedAt DateTime?
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  staff  StaffMember @relation(fields: [staffId], references: [id])

  @@index([tenantId, staffId])
  @@index([tenantId, status])
  @@map("time_off_requests")
}

// --- Credentialing ---
model Credential {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  staffId          String           @db.Uuid
  credentialType   CredentialType
  credentialNumber String           @db.VarChar(100)
  issuingAuthority String           @db.VarChar(200)
  issueDate        DateTime         @db.Date
  expirationDate   DateTime         @db.Date
  status           CredentialStatus @default(ACTIVE)
  attachmentUrl    String?          @db.VarChar(500)
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  staff  StaffMember @relation(fields: [staffId], references: [id])

  @@unique([tenantId, staffId, credentialType])
  @@index([tenantId, staffId])
  @@index([tenantId, expirationDate])
  @@map("credentials")
}

// --- EHR Templates ---
model EhrTemplate {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  name         String        @db.VarChar(200)
  description  String?       @db.Text
  templateType EncounterType
  category     String        @db.VarChar(100) // SOAP, HISTORY, PHYSICAL, NOTE
  content      Json // Template structure (sections, fields)
  isPublic     Boolean       @default(true) // available to all staff in tenant
  createdBy    String        @db.Uuid
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  creator User   @relation(fields: [createdBy], references: [id])

  @@index([tenantId, templateType])
  @@map("ehr_templates")
}

// --- Clinical Decision Support Rules ---
model DecisionSupportRule {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @db.Uuid
  name           String                  @db.VarChar(200)
  description    String?                 @db.Text
  category       DecisionSupportCategory
  severity       DecisionSupportSeverity @default(WARNING)
  condition      Json // Rule condition expression
  action         Json // Alert message, recommendation
  isActive       Boolean                 @default(true)
  appliesToRoles String[] // Staff roles this applies to
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, category])
  @@map("decision_support_rules")
}

// --- Patient Dedup / Merge (Auxiliary table for tracking merges) ---
model PatientMergeLog {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  survivingPatientId String   @db.Uuid
  mergedPatientId    String   @db.Uuid
  mergedAt           DateTime @default(now())
  mergedBy           String   @db.Uuid
  mergeReason        String?  @db.Text
  survivingSnapshot  Json // Snapshot of surviving patient after merge
  mergedSnapshot     Json // Snapshot of merged patient before merge

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, survivingPatientId])
  @@map("patient_merge_logs")
}

// --- Telemedicine Sessions ---
model TelemedicineSession {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  appointmentId    String    @unique @db.Uuid
  patientId        String    @db.Uuid
  staffId          String    @db.Uuid
  status           String    @db.VarChar(50) // SCHEDULED, IN_WAITING_ROOM, IN_PROGRESS, COMPLETED, CANCELLED
  roomName         String    @unique @db.VarChar(200)
  roomToken        String?   @db.Text
  startedAt        DateTime?
  endedAt          DateTime?
  durationMinutes  Int?
  isRecorded       Boolean   @default(false)
  recordingUrl     String?   @db.VarChar(500)
  recordingConsent Boolean   @default(false)
  bandwidthScore   String?   @db.VarChar(20) // EXCELLENT, GOOD, FAIR, POOR
  qualityScore     String?   @db.VarChar(20) // HD, STANDARD, LOW
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant                  Tenant                    @relation(fields: [tenantId], references: [id])
  appointment             Appointment               @relation(fields: [appointmentId], references: [id])
  patient                 Patient                   @relation(fields: [patientId], references: [id])
  staff                   StaffMember               @relation(fields: [staffId], references: [id])
  TelemedicineChatMessage TelemedicineChatMessage[]

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@index([tenantId, staffId])
  @@map("telemedicine_sessions")
}

// --- Referrals (NEW - Phase 12) ---
enum ReferralStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  BOOKED
  COMPLETED
  CLOSED
  CANCELLED
}

enum ReferralPriority {
  URGENT
  SEMI_URGENT
  ROUTINE
}

enum ReferralType {
  EXTERNAL_SPECIALIST
  INTERNAL_SPECIALIST
  ALLIED_HEALTH
  DIAGNOSTIC_IMAGING
  PATHOLOGY
  HOSPITAL
  COMMUNITY_SERVICE
}

model Referral {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  patientId          String           @db.Uuid
  referringStaffId   String           @db.Uuid
  referralType       ReferralType
  priority           ReferralPriority @default(ROUTINE)
  status             ReferralStatus   @default(DRAFT)
  specialistName     String?          @db.VarChar(200)
  specialistContact  String?          @db.VarChar(200)
  specialty          String?          @db.VarChar(200)
  facility           String?          @db.VarChar(200)
  reason             String           @db.Text
  clinicalNotes      String?          @db.Text
  letterContent      String?          @db.Text // Generated referral letter
  diagnosisCodes     Json? // [{code, description}]
  requestedDate      DateTime
  acknowledgedAt     DateTime?
  bookedAt           DateTime?
  completedAt        DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?          @db.Text
  responseNotes      String?          @db.Text // Specialist response
  attachments        Json             @default("[]") // Referral attachment keys
  isUrgent           Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  patient        Patient     @relation(fields: [patientId], references: [id])
  referringStaff StaffMember @relation(fields: [referringStaffId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@index([tenantId, referringStaffId])
  @@index([tenantId, priority])
  @@map("referrals")
}

// --- Care Plans / Chronic Disease Management (NEW - Phase 12) ---
enum CarePlanType {
  GP_MANAGEMENT_PLAN
  TEAM_CARE_ARRANGEMENT
  MENTAL_HEALTH_TREATMENT_PLAN
  HEALTH_ASSESSMENT
  CHRONIC_DISEASE_MANAGEMENT
  MULTIDISCIPLINARY_CARE
}

enum CarePlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  REVIEW_DUE
}

model CarePlan {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  patientId           String         @db.Uuid
  staffId             String         @db.Uuid
  planType            CarePlanType
  status              CarePlanStatus @default(ACTIVE)
  title               String         @db.VarChar(200)
  description         String?        @db.Text
  diagnosisCodes      Json? // [{code, description, isPrimary}]
  goals               Json           @default("[]") // Array of {description, targetDate, achieved, achievedAt, notes}
  interventions       Json           @default("[]") // Array of {description, frequency, provider, startDate, endDate, notes}
  teamMembers         Json           @default("[]") // Array of {name, role, discipline, organization, contact}
  clinicalIndicators  Json? // [{name, value, target, date}] e.g. HbA1c, BP
  startDate           DateTime       @db.Date
  reviewDate          DateTime?      @db.Date
  completedDate       DateTime?      @db.Date
  expiryDate          DateTime?      @db.Date
  lastReviewDate      DateTime?
  nextReviewDate      DateTime?
  isSharedWithPatient Boolean        @default(false)
  patientNotes        String?        @db.Text
  clinicalNotes       String?        @db.Text
  externalReferences  Json           @default("[]") // Links to encounters, documents, referrals
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  patient Patient     @relation(fields: [patientId], references: [id])
  staff   StaffMember @relation(fields: [staffId], references: [id])

  @@index([tenantId, patientId])
  @@index([tenantId, planType])
  @@index([tenantId, status])
  @@index([tenantId, nextReviewDate])
  @@map("care_plans")
}

// --- Medical Certificates (NEW - Phase 12) ---
enum CertificateType {
  SICK_LEAVE
  WORKERS_COMPENSATION
  FITNESS_FOR_WORK
  MEDICAL_EXEMPTION
  VACCINATION_EXEMPTION
  ACC_INJURY_REPORT // New Zealand ACC
  WORKCOVER_CERTIFICATE // Australia
  GENERAL_MEDICAL
}

enum CertificateStatus {
  DRAFT
  ISSUED
  VOID
  EXPIRED
}

model MedicalCertificate {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  patientId         String            @db.Uuid
  staffId           String            @db.Uuid
  certificateType   CertificateType
  status            CertificateStatus @default(DRAFT)
  certificateNumber String            @unique @db.VarChar(50)
  issueDate         DateTime          @default(now())
  startDate         DateTime          @db.Date
  endDate           DateTime?         @db.Date
  diagnosisCode     String?           @db.VarChar(20)
  diagnosisDesc     String?           @db.VarChar(500)
  restrictions      String?           @db.Text
  recommendations   String?           @db.Text
  body              String?           @db.Text // Full certificate text
  verificationCode  String?           @db.VarChar(20) // QR-code verifiable
  employerName      String?           @db.VarChar(200)
  employerContact   String?           @db.VarChar(200)
  isDigitallySigned Boolean           @default(false)
  digitalSignature  String?           @db.Text
  signedAt          DateTime?
  voidReason        String?           @db.Text
  attachments       Json              @default("[]")
  notes             String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  patient Patient     @relation(fields: [patientId], references: [id])
  staff   StaffMember @relation(fields: [staffId], references: [id])

  @@index([tenantId, patientId])
  @@index([tenantId, certificateType])
  @@index([tenantId, status])
  @@index([tenantId, issueDate])
  @@map("medical_certificates")
}

// --- Patient Intake / Self-Registration (NEW - Phase 12) ---
enum IntakeStatus {
  PENDING
  COMPLETED
  REVIEWED
  REJECTED
}

model PatientIntake {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @db.Uuid
  patientId         String?      @db.Uuid // null until registration completes
  status            IntakeStatus @default(PENDING)
  firstName         String       @db.VarChar(100)
  lastName          String       @db.VarChar(100)
  email             String       @db.VarChar(255)
  phone             String?      @db.VarChar(20)
  dateOfBirth       DateTime     @db.Date
  gender            Gender
  address           Json         @default("{}")
  emergencyContact  Json? // EmergencyContact
  medicalHistory    Json? // Self-reported conditions, medications, allergies
  insuranceInfo     Json? // Self-reported insurance
  consentToTreat    Boolean      @default(false)
  consentPrivacy    Boolean      @default(false)
  consentTelehealth Boolean      @default(false)
  identifiers       Json? // Government IDs uploaded {type, value, verified}
  documents         Json         @default("[]") // Uploaded document keys (ID, card, referral)
  reviewedBy        String?      @db.Uuid
  reviewedAt        DateTime?
  rejectionReason   String?      @db.Text
  registrationToken String?      @unique @db.VarChar(100) // For email verification
  tokenExpiresAt    DateTime?
  verifiedAt        DateTime?
  source            String       @default("PORTAL") @db.VarChar(50) // PORTAL, KIOSK, RECEPTION
  notes             String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  patient  Patient?     @relation(fields: [patientId], references: [id])
  reviewer StaffMember? @relation(fields: [reviewedBy], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, registrationToken])
  @@map("patient_intakes")
}

// --- SNOMED CT Codes Directory (NEW - Phase 12) ---
model SnomedCtCode {
  id          String   @id @default(uuid()) @db.Uuid
  conceptId   String   @unique @db.VarChar(20) // SNOMED CT Concept ID
  description String   @db.VarChar(500)
  parentId    String?  @db.VarChar(20)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("snomed_ct_codes")
}

// --- Code Mapping: ICD-10 <-> SNOMED CT (NEW - Phase 12) ---
model CodeMapping {
  id           String   @id @default(uuid()) @db.Uuid
  sourceSystem String   @db.VarChar(20) // ICD10, SNOMED_CT
  sourceCode   String   @db.VarChar(20)
  targetSystem String   @db.VarChar(20) // SNOMED_CT, ICD10
  targetCode   String   @db.VarChar(20)
  mappingType  String   @default("EQUIVALENT") @db.VarChar(50) // EQUIVALENT, BROADER, NARROWER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sourceSystem, sourceCode, targetSystem])
  @@index([sourceSystem, sourceCode])
  @@index([targetSystem, targetCode])
  @@map("code_mappings")
}

// --- Telemedicine Waiting Room Messages (in-consult chat) ---
model TelemedicineChatMessage {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @db.Uuid
  senderId   String   @db.Uuid
  senderType String   @db.VarChar(20) // STAFF, PATIENT
  message    String   @db.Text
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  session TelemedicineSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
  @@map("telemedicine_chat_messages")
}

// ============================================================================
// Phase 11: Country Profiles & Regional Compliance
// ============================================================================

// === Country Profile Configuration ===

model CountryProfileConfig {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  countryCode      String   @db.VarChar(2) // AU, NZ, US, UK, CA
  countryName      String   @db.VarChar(100)
  diagnosisSystem  String   @db.VarChar(50) // ICD10, SNOMED_CT, READ_V2, etc.
  currency         String   @default("AUD") @db.VarChar(3)
  dateFormat       String   @default("dd/MM/yyyy") @db.VarChar(20)
  phoneFormat      String?  @db.VarChar(50)
  postalCodeFormat String?  @db.VarChar(50)
  defaultLanguage  String   @default("en") @db.VarChar(10)
  timezone         String   @db.VarChar(50)
  regulatoryBody   String?  @db.VarChar(200)
  privacyAct       String?  @db.VarChar(200)
  dataRegion       String   @db.VarChar(2) // AU, NZ, US, EU
  modules          Json     @default("[]") // CountryModuleConfig[]
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, countryCode])
  @@index([tenantId])
  @@index([countryCode])
  @@map("country_profile_configs")
}

// === AU: MBS Claim Submissions ===

model MbsClaimSubmission {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  patientId         String    @db.Uuid
  claimNumber       String    @db.VarChar(50)
  items             Json      @default("[]") // MbsClaimItem[]
  totalAmount       Decimal   @db.Decimal(12, 2)
  totalBenefit      Decimal   @db.Decimal(12, 2)
  submissionMethod  String    @db.VarChar(50) // MEDICARE_ONLINE, ECLIPSE, HIB
  submissionChannel String    @db.VarChar(50) // ELECTRONIC, WEB_PORTAL, PAPER, BATCH
  status            String    @default("DRAFT") @db.VarChar(50)
  submittedAt       DateTime?
  responseData      Json? // Medicare response
  medicareReference String?   @db.VarChar(50)
  errorMessage      String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@index([tenantId, claimNumber])
  @@map("mbs_claim_submissions")
}

// === AU: MBS Items Directory ===

model MbsItem {
  id          String   @id @default(uuid()) @db.Uuid
  itemNumber  String   @db.VarChar(20)
  description String   @db.VarChar(500)
  itemType    String   @db.VarChar(50) // CONSULTATION, PROCEDURE, etc.
  scheduleFee Decimal  @db.Decimal(12, 2)
  benefitAmt  Decimal  @db.Decimal(12, 2)
  isClaimable Boolean  @default(true)
  rules       Json     @default("[]") // claim rules
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([itemNumber])
  @@index([itemType])
  @@map("mbs_items")
}

// === AU: PBS Prescriptions ===

model PbsPrescription {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  patientId             String    @db.Uuid
  staffId               String    @db.Uuid
  pbsCode               String    @db.VarChar(20)
  medicationName        String    @db.VarChar(300)
  strength              String    @db.VarChar(100)
  quantity              Int
  repeats               Int       @default(0)
  category              String    @db.VarChar(50) // GENERAL, CONCESSIONAL, SAFETY_NET
  safetyNetEntitlement  Boolean   @default(false)
  concessionCardNumber  String?   @db.VarChar(50)
  authorityPrescription Boolean   @default(false)
  authorityNumber       String?   @db.VarChar(50)
  streamlinedAuthority  Boolean   @default(false)
  specialContributions  Boolean   @default(false)
  status                String    @default("DRAFT") @db.VarChar(50)
  submittedAt           DateTime?
  pharmacyId            String?   @db.Uuid
  errorMessage          String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient     @relation(fields: [patientId], references: [id])
  staff   StaffMember @relation(fields: [staffId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@map("pbs_prescriptions")
}

// === AU: My Health Record Documents ===

model MyHealthRecordDocument {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  patientId       String    @db.Uuid
  documentType    String    @db.VarChar(50) // SHARED_HEALTH_SUMMARY, EVENT_SUMMARY, etc.
  clinicalDocId   String    @db.VarChar(100)
  title           String    @db.VarChar(200)
  description     String?   @db.Text
  authoredAt      DateTime
  status          String    @db.VarChar(50)
  ihiNumber       String    @db.VarChar(16) // Individual Healthcare Identifier
  source          String    @db.VarChar(100)
  documentPayload Json? // CDA document payload
  uploadedToMhr   Boolean   @default(false)
  uploadedAt      DateTime?
  mhrDocumentId   String?   @db.VarChar(100)
  errorMessage    String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("my_health_record_documents")
}

// === AU: AIR (Australian Immunisation Register) Submissions ===

model AirRecordSubmission {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid
  patientId            String    @db.Uuid
  vaccineName          String    @db.VarChar(200)
  airVaccineCode       String    @db.VarChar(20)
  administrationDate   DateTime  @db.Date
  doseNumber           Int
  lotNumber            String    @db.VarChar(50)
  manufacturer         String    @db.VarChar(200)
  administeringStaffId String    @db.Uuid
  status               String    @default("PENDING") @db.VarChar(50) // RECORDED, PENDING, ERROR, DUPLICATE
  airReference         String?   @db.VarChar(50)
  errorMessage         String?   @db.Text
  submittedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@map("air_record_submissions")
}

// === AU: PIP (Practice Incentives Program) Reports ===

model PipReport {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  reportPeriod   String   @db.VarChar(20) // e.g. "2026-Q1"
  reportType     String   @db.VarChar(50) // e.g. "QUALITY_IMPROVEMENT"
  indicators     Json     @default("[]") // PipIndicator[]
  totalIncentive Decimal  @default(0) @db.Decimal(12, 2)
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, reportPeriod])
  @@map("pip_reports")
}

// === NZ: MOH Claim Submissions ===

model NzClaimSubmission {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  patientId        String    @db.Uuid
  claimType        String    @db.VarChar(50) // GP_VISIT, ACC_INJURY, etc.
  claimNumber      String    @db.VarChar(50)
  serviceDate      DateTime  @db.Date
  items            Json      @default("[]") // NzClaimItem[]
  totalAmount      Decimal   @db.Decimal(12, 2)
  subsidyAmount    Decimal   @db.Decimal(12, 2)
  patientCoPay     Decimal   @db.Decimal(12, 2)
  submissionMethod String    @db.VarChar(50)
  status           String    @default("DRAFT") @db.VarChar(50)
  phoOrgId         String?   @db.VarChar(100)
  submittedAt      DateTime?
  responseData     Json?
  errorMessage     String?   @db.Text
  createdAt        DateTime  @default(now())

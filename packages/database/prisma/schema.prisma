// === Saved Reports (Custom Report Builder) ===

enum ReportFormat {
  TABLE
  CHART
  PIVOT
  SUMMARY
}

enum ReportScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReportDeliveryMethod {
  EMAIL
  PRINT
  DASHBOARD
  EXPORT
}

model SavedReport {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String                   @db.Uuid
  name              String                   @db.VarChar(200)
  description       String?                  @db.Text
  category          String                   @db.VarChar(100) // REVENUE, APPOINTMENTS, CLINICAL, OPERATIONS
  reportConfig      Json // Full report configuration
  format            ReportFormat             @default(TABLE)
  isScheduled       Boolean                  @default(false)
  scheduleFrequency ReportScheduleFrequency?
  scheduleConfig    Json? // { dayOfWeek, dayOfMonth, time, timezone }
  deliveryMethod    ReportDeliveryMethod?    @default(DASHBOARD)
  recipients        String[] // User IDs or email addresses
  lastRunAt         DateTime?
  nextRunAt         DateTime?
  createdBy         String                   @db.Uuid
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  ReportExecutionLog ReportExecutionLog[]

  @@index([tenantId, category])
  @@index([tenantId, createdBy])
  @@index([tenantId, isScheduled])
  @@map("saved_reports")
}

// === Report Execution Log ===

model ReportExecutionLog {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  reportId      String?   @db.Uuid
  reportName    String    @db.VarChar(200)
  executionType String    @db.VarChar(50) // MANUAL, SCHEDULED, ON_DEMAND
  status        String    @db.VarChar(50) // RUNNING, COMPLETED, FAILED
  resultSummary Json? // Row count, totals
  outputFormat  String?   @db.VarChar(50) // CSV, JSON, PDF, HTML
  outputUrl     String?   @db.VarChar(500)
  errorMessage  String?   @db.Text
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int? // Execution time in milliseconds
  createdBy     String    @db.Uuid
  createdAt     DateTime  @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  report SavedReport? @relation(fields: [reportId], references: [id])

  @@index([tenantId, reportId])
  @@index([tenantId, startedAt])
  @@map("report_execution_logs")
}

// === Revenue Analytics Snapshot (cached for dashboards) ===

model RevenueAnalyticsSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  snapshotDate DateTime @default(now())
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date

  // Revenue totals
  totalRevenue     Decimal @default(0) @db.Decimal(14, 2)
  totalBilled      Decimal @default(0) @db.Decimal(14, 2)
  totalCollected   Decimal @default(0) @db.Decimal(14, 2)
  totalAdjustments Decimal @default(0) @db.Decimal(14, 2)
  totalRefunds     Decimal @default(0) @db.Decimal(14, 2)
  netRevenue       Decimal @default(0) @db.Decimal(14, 2)

  // Payer mix breakdown
  payerMix         Json @default("[]") // [{payer, billed, collected, count}]
  procedureRevenue Json @default("[]") // [{cptCode, description, revenue, count}]

  // A/R data
  totalAR           Decimal @default(0) @db.Decimal(14, 2)
  arDaysOutstanding Decimal @default(0) @db.Decimal(10, 2)

  // Collections
  collectionRate   Decimal @default(0) @db.Decimal(5, 2) // Percentage
  averageClaimAge  Int     @default(0) // Days
  denialRate       Decimal @default(0) @db.Decimal(5, 2)
  topDenialReasons Json    @default("[]")

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, periodStart, periodEnd])
  @@map("revenue_analytics_snapshots")
}

// === Appointment Utilization Analytics ===

model AppointmentUtilizationSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  snapshotDate DateTime @default(now())
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date

  // Capacity & fill rates
  totalSlots     Int     @default(0)
  filledSlots    Int     @default(0)
  fillRate       Decimal @default(0) @db.Decimal(5, 2) // Percentage
  cancelledSlots Int     @default(0)
  noShowSlots    Int     @default(0)

  // Peak times analysis
  peakTimes   Json @default("[]") // [{hour, dayOfWeek, count}]
  byDayOfWeek Json @default("[]") // [{day, total, filled, cancelled, noShow}]
  byStaff     Json @default("[]") // [{staffId, staffName, total, filled, rate}]
  byType      Json @default("[]") // [{type, total, percentage}]

  // No-show patterns
  noShowRate      Decimal @default(0) @db.Decimal(5, 2)
  noShowTrend     Json    @default("[]")
  averageWaitTime Decimal @default(0) @db.Decimal(10, 2) // Minutes

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, periodStart, periodEnd])
  @@map("appointment_utilization_snapshots")
}

// === Clinician Productivity Snapshot ===

model ClinicianProductivitySnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  staffId      String   @db.Uuid
  snapshotDate DateTime @default(now())
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date

  // Encounters
  totalEncounters        Int     @default(0)
  encountersPerDay       Decimal @default(0) @db.Decimal(8, 2)
  newPatients            Int     @default(0)
  followUpPatients       Int     @default(0)
  telemedicineEncounters Int     @default(0)

  // RVUs
  totalRVUs        Decimal @default(0) @db.Decimal(10, 2)
  rvusPerEncounter Decimal @default(0) @db.Decimal(8, 2)
  rvusPerDay       Decimal @default(0) @db.Decimal(8, 2)

  // Revenue
  revenueGenerated    Decimal @default(0) @db.Decimal(14, 2)
  revenuePerEncounter Decimal @default(0) @db.Decimal(10, 2)
  revenuePerDay       Decimal @default(0) @db.Decimal(10, 2)

  // Quality
  patientSatisfaction Decimal? @db.Decimal(5, 2)
  noShowRate          Decimal  @default(0) @db.Decimal(5, 2)
  onTimeRate          Decimal  @default(0) @db.Decimal(5, 2)


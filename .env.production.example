# ============================================================================
# TPT Doctor — Production Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.production.example .env
# ============================================================================

# ── Application ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=https://your-domain.com,https://portal.your-domain.com

# ── Database (PostgreSQL) ────────────────────────────────────────────────
# For local Docker: postgresql://tpt_admin:YOUR_PASSWORD@postgres:5432/tpt_doctor
# For external: postgresql://user:password@host:5432/tpt_doctor?sslmode=require
DATABASE_URL=postgresql://tpt_admin:CHANGE_ME@postgres:5432/tpt_doctor
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────────────────
# For local Docker: redis://:YOUR_REDIS_PASSWORD@redis:6379
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PREFIX=tpt:
REDIS_PASSWORD=CHANGE_ME

# ── Authentication ───────────────────────────────────────────────────────
# REQUIRED: Set up an Auth0 tenant at https://auth0.com/signup
# Create an API in Auth0 with identifier: https://api.tptdoctor.com
# Create a Single Page Application for the web app
# Create a Regular Web Application for the API
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.tptdoctor.com
AUTH0_CLIENT_ID=your-api-client-id
AUTH0_CLIENT_SECRET=your-api-client-secret
AUTH0_WEB_CLIENT_ID=your-web-client-id
AUTH0_PORTAL_CLIENT_ID=your-portal-client-id
AUTH0_MANAGEMENT_API_TOKEN=

# ── Encryption (REQUIRED — generate a secure key) ───────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_PROVIDER=local
ENCRYPTION_MASTER_KEY=CHANGE_ME_TO_A_64_CHAR_HEX_KEY
ENCRYPTION_MASTER_KEY_ID=tpt-doctor-prod

# ── Storage (S3-compatible, MinIO for self-hosted) ──────────────────────
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=tpt-doctor-files
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_FORCE_PATH_STYLE=true

# ── Payments (optional — leave empty to disable) ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
AIRWALLEX_API_KEY=
AIRWALLEX_CLIENT_ID=
AIRWALLEX_WEBHOOK_SECRET=

# ── SMS / Notifications (optional) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Telemedicine (optional — uses Jitsi by default) ─────────────────────
TELEMEDICINE_PROVIDER=jitsi
JITSI_DOMAIN=meet.your-domain.com
TWILIO_VIDEO_API_KEY=
TWILIO_VIDEO_API_SECRET=

# ── Logging & Monitoring ────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=
PROMETHEUS_ENABLED=true
METRICS_PORT=9464

# ── PostgreSQL (for Docker Compose only) ────────────────────────────────
POSTGRES_USER=tpt_admin
POSTGRES_PASSWORD=CHANGE_ME

# ── MinIO (for Docker Compose only) ─────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# ── Grafana (for Docker Compose only) ───────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── Jitsi (for Docker Compose only) ─────────────────────────────────────
JITSI_PASSWORD=CHANGE_ME